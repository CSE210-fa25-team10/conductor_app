### Conductor server environment variables (local template)
# Copy this file to `.env` and replace values for local development.

# Server options
PORT=3000
SESSION_SECRET=replace-me-with-a-secure-secret

# Database URL (e.g., postgres://user:password@host:5432/database)
DATABASE_URL=postgres://appuser:apppassword@localhost:5432/conductor

# Google OAuth / API
# NOTE: Do NOT place real client secrets or API keys in this template. Substitute your
# real values into a *local* `conductor-server/.env` file which is ignored by git.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
# Optional: server-side API key (only if server needs to call Google APIs directly)
GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY

# Attendance / Frontend
ATTENDANCE_PIN_SECRET=replace-me
FRONTEND_BASE_URL=http://localhost:3000
