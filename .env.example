# ---- Postgres (docker-compose local) ----
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=conductor

# ---- Backend ----
NODE_ENV=development
PORT=3000

# Compose networking: service name "db" is the hostname inside the compose network
DATABASE_URL=postgresql://appuser:apppassword@db:5432/conductor

# Comma-separated list for dev frontends (optional)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Generate method：openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=super-strong-32-chars-key-generated-here
JWT_EXPIRES_IN=7d